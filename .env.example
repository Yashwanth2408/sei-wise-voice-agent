APP_ENV=local
DEEPGRAM_API_KEY=your_deepgram_key_here
GROQ_API_KEY=your_groq_key_here
CARTESIA_API_KEY=your_cartesia_key_here
CARTESIA_VOICE_ID=your_voice_id_here
CARTESIA_MODEL=sonic-3
GROQ_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_ROOM_PREFIX=wise
WISE_FAQ_DOC_PATH=data/wise_where_is_my_money_faq.md
WISE_FAQ_INDEX_PATH=src/wise_voice_agent/knowledge/faq_index.md
SESSION_TIMEOUT_SECONDS=300
BARGE_IN_ENABLED=true
VAD_CONFIDENCE=0.75
VAD_START_SECS=0.12
VAD_STOP_SECS=0.45
VAD_MIN_VOLUME=0.45
PAUSE_CALL_SECONDS=10
PAUSE_CHECKIN_MESSAGE=Are you still there? Can we continue?
